# Enterprise Agentic QA Operations Platform — Environment Configuration Template
# Copy this file to .env and adjust variables for your local or staging environment.

# General Environment
ENVIRONMENT=development
DEMO_MODE=true
SECRET_KEY=replace-with-a-secure-random-256-bit-key-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database Configuration
# Local SQLite for instant zero-configuration development:
DATABASE_URL=sqlite:///./enterprise_qa_ops.db

# Production PostgreSQL:
# DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/agentic_qa_ops

# Keycloak Identity & Access Management (OAuth2 / OIDC)
KEYCLOAK_ENABLED=false
KEYCLOAK_SERVER_URL=http://localhost:8080/auth
KEYCLOAK_REALM=enterprise-qa
KEYCLOAK_CLIENT_ID=qa-ops-platform
KEYCLOAK_CLIENT_SECRET=

# AI Model Provider Configuration (LangGraph Orchestration)
# Options: mock | openai | gemini | anthropic
LLM_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-pro

# GitHub Integration
# Options: mock | live
GITHUB_INTEGRATION_MODE=mock
GITHUB_TOKEN=
GITHUB_ORG=enterprise-qa-demo
